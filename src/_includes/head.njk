{#- =====================================================
    HEAD — metas, Open Graph, datos estructurados y estilos.
    Cada página define arriba de todo (entre los ---):
      titulo      → texto de la pestaña y de Google (hasta 60 caracteres)
      descripcion → resumen para Google y al compartir (70 a 160 caracteres)
      estilos     → "home", "paginas" o "segmento" (qué hoja de estilos carga)
      producto    → (opcional) nombre y descripción para el JSON-LD de producto
      indexar     → (opcional) false = Google y las IAs no la indexan (páginas en construcción)
    El dominio y los datos de la empresa están en src/_data/sitio.json.
    ===================================================== #}
{%- set urlPagina = sitio.dominio + ("/" if page.url == "/index.html" else page.url) %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ titulo }}</title>
  <meta name="description" content="{{ descripcion }}">
  <!-- Dirección oficial de la página: evita que Google la cuente dos veces (con y sin dominio propio) -->
  <link rel="canonical" href="{{ urlPagina }}">
  {%- if indexar === false %}
  <meta name="robots" content="noindex, follow">
  {%- endif %}
  <meta name="theme-color" content="#7a4aeb">
  <!-- Marca que el JavaScript está activo: recién ahí se ocultan las secciones que aparecen con animación (.reveal) -->
  <script>document.documentElement.classList.add('js')</script>
  <link rel="icon" href="{{ raiz }}public/favicon.ico" sizes="16x16 32x32 48x48">

  <!-- Tipografías alojadas en el sitio (public/fonts). Se precarga la principal. -->
  <link rel="preload" href="{{ raiz }}public/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Una sola hoja de estilos: la arma Eleventy uniendo los archivos de src/styles (ver eleventy.config.mjs) -->
  <link rel="stylesheet" href="{{ raiz }}src/styles/sitio-{{ estilos }}.css">

  <!-- Al compartir el link (WhatsApp, LinkedIn, X): título, descripción e imagen -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ sitio.nombre }}">
  <meta property="og:locale" content="es_AR">
  <meta property="og:title" content="{{ titulo }}">
  <meta property="og:description" content="{{ descripcion }}">
  <meta property="og:url" content="{{ urlPagina }}">
  <meta property="og:image" content="{{ sitio.dominio }}/{{ sitio.imagenCompartir }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Datos estructurados (JSON-LD): ayudan a Google y a los asistentes de IA a entender qué es Thinkion -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ sitio.dominio }}/#org",
        "name": {{ sitio.nombre | dump | safe }},
        "legalName": {{ sitio.razonSocial | dump | safe }},
        "url": "{{ sitio.dominio }}/",
        "description": {{ sitio.descripcion | dump | safe }},
        "logo": "{{ sitio.dominio }}/public/img/home/logo-thinkion-oscuro.svg",
        "email": {{ sitio.email | dump | safe }},
        "areaServed": "AR",
        "sameAs": [{{ sitio.instagram | dump | safe }}, {{ sitio.linkedin | dump | safe }}]
      },
      {
        "@type": "WebSite",
        "@id": "{{ sitio.dominio }}/#web",
        "name": {{ sitio.nombre | dump | safe }},
        "url": "{{ sitio.dominio }}/",
        "inLanguage": "es-AR",
        "publisher": { "@id": "{{ sitio.dominio }}/#org" }
      }
      {%- if producto %},
      {
        "@type": "SoftwareApplication",
        "name": {{ producto.nombre | dump | safe }},
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web, Android, iOS",
        "description": {{ producto.descripcion | dump | safe }},
        "url": "{{ urlPagina }}",
        "publisher": { "@id": "{{ sitio.dominio }}/#org" }
      }
      {%- endif %}
      {%- if preguntasFrecuentes %},
      "__PREGUNTAS_FRECUENTES__"
      {%- endif %}
    ]
  }
  </script>
