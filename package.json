{
  "name": "web-thinkion",
  "private": true,
  "type": "module",
  "description": "Sitio institucional de Thinkion. HTML, CSS y JS vanilla; Eleventy solo arma el menú, el footer y el head compartidos en la carpeta _site. Nada de esto llega al navegador.",
  "scripts": {
    "dev": "eleventy --serve --port=8080",
    "build": "eleventy",
    "servir": "http-server _site -p 8080 -s",
    "test": "eleventy && playwright test",
    "lighthouse": "eleventy && lhci autorun",
    "admin": "node scripts/servidor-local.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "http-server": "^14.1.1",
    "linkedom": "^0.18.13"
  }
}
