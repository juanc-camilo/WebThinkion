{
  "name": "web-thinkion",
  "private": true,
  "type": "module",
  "description": "Sitio institucional de Thinkion. Next.js + Puck: las páginas se arman con bloques desde el panel /admin y se guardan en contenido/ (JSON).",
  "scripts": {
    "dev": "node scripts/preparar.mjs && next dev -p 8080",
    "build": "node scripts/preparar.mjs && next build",
    "start": "next start -p 8080",
    "test": "npm run build && playwright test",
    "lighthouse": "npm run build && lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0"
  },
  "dependencies": {
    "@puckeditor/core": "0.23.0",
    "@vercel/blob": "2.8.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
