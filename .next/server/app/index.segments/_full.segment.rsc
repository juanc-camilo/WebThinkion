35:Taf1,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://webthinkion.vercel.app/#org","name":"Thinkion","legalName":"Thinkion SAS","url":"https://webthinkion.vercel.app/","description":"Thinkion es un ecosistema de software que se adapta a tu negocio: POS, ERP, compras y auditorías integrados en un solo lugar para gastronomía, retail y servicios.","logo":"https://webthinkion.vercel.app/img/home/logo-thinkion-oscuro.svg","email":"marketing@thinkion.com.ar","areaServed":"AR","sameAs":["https://www.instagram.com/_thinkion_/","https://www.linkedin.com/company/b-smart/posts/"]},{"@type":"WebSite","@id":"https://webthinkion.vercel.app/#web","name":"Thinkion","url":"https://webthinkion.vercel.app/","inLanguage":"es-AR","publisher":{"@id":"https://webthinkion.vercel.app/#org"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"¿Qué es Thinkion y a quién está dirigido?","acceptedAnswer":{"@type":"Answer","text":"Thinkion es una plataforma que unifica todas las herramientas que necesitás para gestionar tu negocio. Está pensada para gastronomía, retail y servicios , y te ayuda a simplificar la operación y crecer con control."}},{"@type":"Question","name":"¿Necesito ser un experto en tecnología para usar Thinkion?","acceptedAnswer":{"@type":"Answer","text":"No. Thinkion está pensado para que cualquier persona de tu equipo lo use desde el primer día, y te acompañamos en la implementación."}},{"@type":"Question","name":"¿Thinkion puede integrarse con los sistemas que ya uso?","acceptedAnswer":{"@type":"Answer","text":"Sí. Thinkion se integra con plataformas de delivery, medios de pago, facturación electrónica y otras herramientas que ya usás."}},{"@type":"Question","name":"¿Qué tipo de soporte técnico ofrecen?","acceptedAnswer":{"@type":"Answer","text":"Tenemos un equipo de soporte que te ayuda por WhatsApp, mail y teléfono para que tu operación nunca se detenga."}},{"@type":"Question","name":"¿Puedo manejar varias sucursales?","acceptedAnswer":{"@type":"Answer","text":"Sí. Controlás stock, ventas y precios de todas tus sucursales desde un mismo panel."}},{"@type":"Question","name":"¿Sirve para restaurantes con delivery?","acceptedAnswer":{"@type":"Answer","text":"Sí. Integrás mesas, mostrador y delivery en un solo sistema, con los pedidos de todas las plataformas en un mismo lugar."}},{"@type":"Question","name":"¿Qué módulos incluye Thinkion?","acceptedAnswer":{"@type":"Answer","text":"POS, ERP, compras, auditorías, fidelización, reportes BI y más. Podés sumar solo los que necesitás."}},{"@type":"Question","name":"¿Cuánto cuesta Thinkion?","acceptedAnswer":{"@type":"Answer","text":"Depende de los módulos y la cantidad de locales. Pedí tu demo y te armamos una propuesta a medida."}}]}]}1e:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$35"}}]
